node_modules/
.next/
.env.local
.env*.local
*.log
.DS_Store
.superpowers/

# src/brand.config.ts is generated per-deploy by `npm run init` (template: scripts/init/brand.config.template.ts).
src/brand.config.ts

# init wizard writes timestamped backups of secret/brand files before overwriting — never commit them.
src/brand.config.ts.bak.*
.env.local.bak.*

# Operational data (recipient lists, send logs with addresses, suppression list, AI key, user-made
# emails) never goes into git. Back it up separately — see docs/production.md "Data backup".
data/
templates/*
!templates/.gitkeep

# TS incremental build cache
tsconfig.tsbuildinfo
